! Export only: reads stair_6_10_harm.rst and writes the reaction files. Use when the solution
! finished but the export did not run. Read with File > Read Input From, in the working directory.
FINISH
! ---- distributed runs: combine the local results files if the global one is missing
/INQUIRE,HAS_RST,EXIST,stair_6_10_harm,rst
*IF,HAS_RST,EQ,0,THEN
/AUX2
COMBINE,RST
FINISH
*ENDIF

! ---- export: reactions at A and B, real and imaginary parts ------------------
/POST26
FILE,stair_6_10_harm,rst
NUMVAR,20
RFORCE,2,1,F,X,FAX
RFORCE,3,1,F,Y,FAY
RFORCE,4,1,F,Z,FAZ
RFORCE,5,630,F,X,FBX
RFORCE,6,630,F,Y,FBY
RFORCE,7,630,F,Z,FBZ
RFORCE,8,630,M,X,MBX
RFORCE,9,630,M,Y,MBY
RFORCE,10,630,M,Z,MBZ
STORE,MERGE
*GET,N_PTS,VARI,0,NSETS
*DIM,RA,ARRAY,N_PTS,7
*DIM,RB,ARRAY,N_PTS,13
VGET,RA(1,1),1
VGET,RA(1,2),2,,0
VGET,RA(1,3),2,,1
VGET,RA(1,4),3,,0
VGET,RA(1,5),3,,1
VGET,RA(1,6),4,,0
VGET,RA(1,7),4,,1
VGET,RB(1,1),1
VGET,RB(1,2),5,,0
VGET,RB(1,3),5,,1
VGET,RB(1,4),6,,0
VGET,RB(1,5),6,,1
VGET,RB(1,6),7,,0
VGET,RB(1,7),7,,1
VGET,RB(1,8),8,,0
VGET,RB(1,9),8,,1
VGET,RB(1,10),9,,0
VGET,RB(1,11),9,,1
VGET,RB(1,12),10,,0
VGET,RB(1,13),10,,1
! columns: f [Hz], then Re and Im of FX, FY, FZ at A [N]
*CFOPEN,stair_6_10_ansys_A,txt
*VWRITE,RA(1,1),RA(1,2),RA(1,3),RA(1,4),RA(1,5),RA(1,6),RA(1,7)
(7E22.13)
*CFCLOS
! columns: f [Hz], then Re and Im of FX, FY, FZ [N], MX, MY, MZ [N m] at B
*CFOPEN,stair_6_10_ansys_B,txt
*VWRITE,RB(1,1),RB(1,2),RB(1,3),RB(1,4),RB(1,5),RB(1,6),RB(1,7),RB(1,8),RB(1,9),RB(1,10),RB(1,11),RB(1,12),RB(1,13)
(13E22.13)
*CFCLOS
FINISH
*CFOPEN,stair_6_10_ansys_done,txt
*VWRITE,N_PTS
('export finished, frequency points: ',F8.0)
*CFCLOS
/COM, ===== EXPORT FINISHED: stair_6_10_ansys_A.txt and stair_6_10_ansys_B.txt written =====
