! ---- natural frequencies with the boundary conditions of the harmonic analysis
*IF,DO_MODAL,EQ,1,THEN
/SOLU
ANTYPE,MODAL
MODOPT,LANB,N_MODES_MAX,0,F_MODAL_MAX
MXPAND,N_MODES_MAX
D,N_A,UX,0
D,N_A,UY,0
D,N_A,UZ,0
D,N_B,ALL,0
SOLVE
FINISH
/POST1
*GET,N_FOUND,ACTIVE,0,SET,NSET
*DIM,FMOD,ARRAY,N_FOUND
*DO,I,1,N_FOUND
*GET,FMOD(I),MODE,I,FREQ
*ENDDO
*CFOPEN,stair_6_10_ansys_modes,txt
*VWRITE,FMOD(1)
(E22.13)
*CFCLOS
FINISH
*ENDIF

! ---- full harmonic analysis ------------------------------------------------
/FILNAME,stair_6_10_harm,0
/SOLU
ANTYPE,HARMIC
HROPT,FULL
HROUT,ON                ! real and imaginary parts
EQSLV,SPARSE
ALPHAD,ALPHA_R
BETAD,BETA_R
DDELE,ALL,ALL
D,N_B,ALL,0
D,N_A,UX,U_AX,U_AX_I
D,N_A,UY,U_AY,U_AY_I
D,N_A,UZ,U_AZ,U_AZ_I
HARFRQ,0,F_MAX,,,%FRQ%,1E-9   ! user-defined frequencies; the single substep of the range falls on F_MAX
NSUBST,1
KBC,1
OUTRES,ERASE
OUTRES,ALL,NONE
OUTRES,NSOL,ALL,ENDS
OUTRES,RSOL,ALL
SOLVE
FINISH

! ---- distributed runs: combine the local results files if the global one is missing
/INQUIRE,HAS_RST,EXIST,stair_6_10_harm,rst
*IF,HAS_RST,EQ,0,THEN
/AUX2
COMBINE,RST
FINISH
*ENDIF

! ---- export: reactions at A and B, real and imaginary parts ------------------
/POST26
FILE,stair_6_10_harm,rst
NUMVAR,20
RFORCE,2,N_A,F,X,FAX
RFORCE,3,N_A,F,Y,FAY
RFORCE,4,N_A,F,Z,FAZ
RFORCE,5,N_B,F,X,FBX
RFORCE,6,N_B,F,Y,FBY
RFORCE,7,N_B,F,Z,FBZ
RFORCE,8,N_B,M,X,MBX
RFORCE,9,N_B,M,Y,MBY
RFORCE,10,N_B,M,Z,MBZ
STORE,MERGE
*GET,N_PTS,VARI,0,NSETS
*DIM,RA,ARRAY,N_PTS,7
*DIM,RB,ARRAY,N_PTS,13
VGET,RA(1,1),1
VGET,RA(1,2),2,,0
VGET,RA(1,3),2,,1
VGET,RA(1,4),3,,0
VGET,RA(1,5),3,,1
VGET,RA(1,6),4,,0
VGET,RA(1,7),4,,1
VGET,RB(1,1),1
VGET,RB(1,2),5,,0
VGET,RB(1,3),5,,1
VGET,RB(1,4),6,,0
VGET,RB(1,5),6,,1
VGET,RB(1,6),7,,0
VGET,RB(1,7),7,,1
VGET,RB(1,8),8,,0
VGET,RB(1,9),8,,1
VGET,RB(1,10),9,,0
VGET,RB(1,11),9,,1
VGET,RB(1,12),10,,0
VGET,RB(1,13),10,,1
! columns: f [Hz], then Re and Im of FX, FY, FZ at A [N]
*CFOPEN,stair_6_10_ansys_A,txt
*VWRITE,RA(1,1),RA(1,2),RA(1,3),RA(1,4),RA(1,5),RA(1,6),RA(1,7)
(7E22.13)
*CFCLOS
! columns: f [Hz], then Re and Im of FX, FY, FZ [N], MX, MY, MZ [N m] at B
*CFOPEN,stair_6_10_ansys_B,txt
*VWRITE,RB(1,1),RB(1,2),RB(1,3),RB(1,4),RB(1,5),RB(1,6),RB(1,7),RB(1,8),RB(1,9),RB(1,10),RB(1,11),RB(1,12),RB(1,13)
(13E22.13)
*CFCLOS
FINISH
*CFOPEN,stair_6_10_ansys_done,txt
*VWRITE,N_PTS
('export finished, frequency points: ',F8.0)
*CFCLOS
/COM, ===== EXPORT FINISHED: stair_6_10_ansys_A.txt and stair_6_10_ansys_B.txt written =====
