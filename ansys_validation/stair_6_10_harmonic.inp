! ==========================================================================
! ACOROUTE verification against Ansys BEAM188
! Case: staircase domain (two baffles), 6-10 kHz, reported route (seed 5)
! Mesh: 630 nodes, 629 two-node elements of about 2.0 mm on the smooth centreline
! Units: SI (m, kg, s, N, Hz)
! Boundary conditions: node A (first) with prescribed translations and free
! rotations; node B (last) clamped. Rayleigh damping C = ALPHA_R*M + BETA_R*K.
! Harmonic sweep from 2 Hz to 11000 Hz with a user-defined frequency list (HARFRQ, FREQARR).
! Recommended: run_ansys_smp.bat (batch, shared-memory parallel: one results file).
! Otherwise File > Read Input From (*VWRITE does not work when the commands are
! pasted in the command line).
! Outputs: stair_6_10_ansys_modes.txt, stair_6_10_ansys_A.txt, stair_6_10_ansys_B.txt
! ==========================================================================
FINISH
/CLEAR,NOSTART
/UIS,MSGPOP,3           ! interactive runs: no pop-up boxes for notes and warnings
/FILNAME,stair_6_10_modal,0
/TITLE,ACOROUTE staircase route - BEAM188 verification

! ---- parameters -----------------------------------------------------------
E_MOD   = 2.100000e+11      ! Young's modulus [Pa]
NU_P    = 0.3000           ! Poisson's ratio
RHO_M   = 7850.0000        ! density [kg/m3]
R_OUT   = 1.575000000e-03   ! outer radius [m]
R_IN    = 1.075000000e-03   ! inner radius [m]
ALPHA_R = 0.000000e+00      ! Rayleigh mass coefficient [1/s]
BETA_R  = 2.000000e-07      ! Rayleigh stiffness coefficient [s]
U_AX    = 1.000000e-06      ! prescribed displacement phasors at A [m] (real parts)
U_AY    = 1.000000e-06
U_AZ    = 1.000000e-06
U_AX_I  = 0.000000e+00      ! imaginary parts
U_AY_I  = 0.000000e+00
U_AZ_I  = 0.000000e+00
F_MAX   = 11000.0000      ! upper limit of the sweep [Hz]; the frequency list FRQ is defined below
N_FRQ   = 11168
DO_MODAL    = 1         ! 1: natural frequencies with the same boundary conditions
F_MODAL_MAX = 12000.0000
N_MODES_MAX = 140       ! upper bound on the number of modes below F_MODAL_MAX
USE_COWPER  = 0         ! 0: shear stiffness computed by Ansys for the CTUBE section
                        ! 1: override with kappa*G*A of ACOROUTE (Cowper, kappa = 0.560481)
KGA     = 1.884398486e+05   ! kappa*G*A [N], used only when USE_COWPER = 1
N_NODES = 630
N_A     = 1             ! driven node
N_B     = N_NODES       ! clamped node

! ---- model ----------------------------------------------------------------
/PREP7
ET,1,BEAM188
KEYOPT,1,1,0            ! six DOF per node, no warping DOF
KEYOPT,1,3,3            ! cubic shape functions
MP,EX,1,E_MOD
MP,PRXY,1,NU_P
MP,DENS,1,RHO_M
SECTYPE,1,BEAM,CTUBE
SECDATA,R_IN,R_OUT,64
*IF,USE_COWPER,EQ,1,THEN
SECCONTROL,KGA,,KGA
*ENDIF
N,1,0.000000000000e+00,0.000000000000e+00,0.000000000000e+00
